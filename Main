"""
ESME Transport Route Planner – PyQt5 Interface
Run: python app.py
"""

import os
import sys
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QComboBox, QPushButton, QFrame, QScrollArea, QSizePolicy,
    QCompleter
)
from PyQt5.QtCore import Qt, QThread, pyqtSignal, QSortFilterProxyModel
from PyQt5.QtGui import QFont, QColor, QPalette, QIcon

from transport import TransportNetwork, dijkstra

# PATHS
BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DATA_DIR = os.path.join(BASE_DIR, "data")

# WORKER THREADS

class RouteWorker(QThread):
    done = pyqtSignal(object)  #result dict or None
    error = pyqtSignal(str)

    def __init__(self, network, origin, destination):
        super().__init__()
        self.network = network
        self.origin = origin
        self.destination = destination

    def run(self):
        try:
            result = dijkstra(self.network, self.origin, self.destination)
            self.done.emit(result)
        except Exception as e:
            self.error.emit(str(e))


# MAIN WINDOW
class TransportApp(QMainWindow):
    def __init__(self):
        super().__init__()
        self.network = TransportNetwork()
        self.cities: dict[str, str] = {}  #name → filepath
        self._worker = None
        self._discover_cities()
        self._build_ui()
        self._load_city(list(self.cities.keys())[0])

    #DISCOVERY

    def _discover_cities(self):
        if not os.path.isdir(DATA_DIR):
            return
        for fn in sorted(os.listdir(DATA_DIR)):
            if fn.endswith(".json"):
                name = fn[:-5].replace("_", " ").capitalize()
                self.cities[name] = os.path.join(DATA_DIR, fn)

    # UI CONSTRUCTION

    def _build_ui(self):
        self.setWindowTitle("Transport Route Planner")
        self.setMinimumSize(480, 640)
        self.resize(520, 720)
        self.setStyleSheet(STYLESHEET)

        root = QWidget()
        root.setObjectName("root")
        self.setCentralWidget(root)

        outer = QVBoxLayout(root)
        outer.setContentsMargins(24, 28, 24, 24)
        outer.setSpacing(0)

        # HEADER
        heading = QLabel("🚇 Route Planner")
        heading.setObjectName("heading")
        sub = QLabel("Find the fastest path in your city's network")
        sub.setObjectName("sub")
        outer.addWidget(heading)
        outer.addSpacing(2)
        outer.addWidget(sub)
        outer.addSpacing(22)

        # SEARCH CARD
        card = QFrame()
        card.setObjectName("card")
        card_layout = QVBoxLayout(card)
        card_layout.setContentsMargins(18, 18, 18, 18)
        card_layout.setSpacing(14)

        # CITY
        city_label = QLabel("City")
        city_label.setObjectName("fieldLabel")
        self.city_combo = QComboBox()
        self.city_combo.addItems(list(self.cities.keys()))
        self.city_combo.currentTextChanged.connect(self._on_city_changed)
        card_layout.addWidget(city_label)
        card_layout.addWidget(self.city_combo)

        # SEPARATOR
        sep = QFrame()
        sep.setFrameShape(QFrame.HLine)
        sep.setStyleSheet(f"color: {BORDER};")
        card_layout.addWidget(sep)

        # ORIGIN
        origin_label = QLabel("From")
        origin_label.setObjectName("fieldLabel")
        self.origin_combo = QComboBox()
        self.origin_combo.setEditable(True)
        self.origin_combo.setInsertPolicy(QComboBox.NoInsert)
        self.origin_combo.completer().setCompletionMode(QCompleter.PopupCompletion)
        self.origin_combo.completer().setFilterMode(Qt.MatchContains)
        card_layout.addWidget(origin_label)
        card_layout.addWidget(self.origin_combo)

        # SWAP BUTTON
        swap_row = QHBoxLayout()
        swap_row.addStretch()
        self.swap_btn = QPushButton("⇅")
        self.swap_btn.setObjectName("swapBtn")
        self.swap_btn.setFixedWidth(44)
        self.swap_btn.setToolTip("Swap origin and destination")
        self.swap_btn.clicked.connect(self._swap_stations)
        swap_row.addWidget(self.swap_btn)
        swap_row.addStretch()
        card_layout.addLayout(swap_row)

        # DESTINATION
        dest_label = QLabel("To")
        dest_label.setObjectName("fieldLabel")
        self.dest_combo = QComboBox()
        self.dest_combo.setEditable(True)
        self.dest_combo.setInsertPolicy(QComboBox.NoInsert)
        self.dest_combo.completer().setCompletionMode(QCompleter.PopupCompletion)
        self.dest_combo.completer().setFilterMode(Qt.MatchContains)
        card_layout.addWidget(dest_label)
        card_layout.addWidget(self.dest_combo)

        # SEARCH BUTTON
        self.search_btn = QPushButton("Find Route")
        self.search_btn.setObjectName("searchBtn")
        self.search_btn.clicked.connect(self._search)
        card_layout.addSpacing(4)
        card_layout.addWidget(self.search_btn)

        outer.addWidget(card)
        outer.addSpacing(18)

        # RESULTS AREA
        self.result_scroll = QScrollArea()
        self.result_scroll.setWidgetResizable(True)
        self.result_scroll.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        self.result_scroll.setSizePolicy(QSizePolicy.Expanding, QSizePolicy.Expanding)

        self.result_container = QWidget()
        self.result_layout = QVBoxLayout(self.result_container)
        self.result_layout.setContentsMargins(0, 0, 0, 0)
        self.result_layout.setSpacing(0)
        self.result_layout.setAlignment(Qt.AlignTop)

        self._show_empty_hint()

        self.result_scroll.setWidget(self.result_container)
        outer.addWidget(self.result_scroll, 1)

    # CITY LOADING

    def _on_city_changed(self, name):
        self._load_city(name)

    def _load_city(self, name):
        if name not in self.cities:
            return
        self.network = TransportNetwork()
        self.network.load_from_json(self.cities[name])
        stations = sorted(self.network.all_stations)

        for combo in (self.origin_combo, self.dest_combo):
            combo.blockSignals(True)
            combo.clear()
            combo.addItems(stations)
            combo.setCurrentIndex(-1)
            combo.setCurrentText("")
            combo.blockSignals(False)

        self._clear_results()
        self._show_empty_hint()

    # SWAP

    def _swap_stations(self):
        a = self.origin_combo.currentText()
        b = self.dest_combo.currentText()
        self.origin_combo.setCurrentText(b)
        self.dest_combo.setCurrentText(a)

    # SEARCH

    def _search(self):
        origin = self.origin_combo.currentText().strip()
        dest = self.dest_combo.currentText().strip()

        self._clear_results()

        if not origin or not dest:
            self._show_error("Please select both a departure and arrival station.")
            return
        if origin == dest:
            self._show_error("Departure and arrival must be different stations.")
            return
        if origin not in self.network.all_stations:
            self._show_error(f'Station not found: "{origin}"')
            return
        if dest not in self.network.all_stations:
            self._show_error(f'Station not found: "{dest}"')
            return

        self.search_btn.setEnabled(False)
        self.search_btn.setText("Searching…")

        self._worker = RouteWorker(self.network, origin, dest)
        self._worker.done.connect(self._on_result)
        self._worker.error.connect(self._on_error)
        self._worker.start()

    def _on_result(self, result):
        self.search_btn.setEnabled(True)
        self.search_btn.setText("Find Route")
        self._clear_results()
        if result is None:
            self._show_error("No route found between these two stations.")
        else:
            self._show_result(result)

    def _on_error(self, msg):
        self.search_btn.setEnabled(True)
        self.search_btn.setText("Find Route")
        self._clear_results()
        self._show_error(msg)

    # RESULT RENDERING

    def _clear_results(self):
        while self.result_layout.count():
            item = self.result_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

    def _show_empty_hint(self):
        hint = QLabel("Select a city, departure and arrival to see the route.")
        hint.setObjectName("emptyHint")
        hint.setAlignment(Qt.AlignCenter)
        hint.setWordWrap(True)
        self.result_layout.addWidget(hint)

    def _show_error(self, msg):
        lbl = QLabel(f"⚠ {msg}")
        lbl.setObjectName("errorMsg")
        lbl.setAlignment(Qt.AlignCenter)
        lbl.setWordWrap(True)
        self.result_layout.addWidget(lbl)

    def _show_result(self, result):
        path = result["path"]
        transfers = set(result["transfers"])
        total_sec = result["total_time"]
        mins, secs = divmod(total_sec, 60)
        n_transfers = len(result["transfers"])

        # SUMMARY HEADER
        header = QFrame()
        header.setObjectName("resultHeader")
        h_layout = QHBoxLayout(header)
        h_layout.setContentsMargins(16, 12, 16, 12)

        time_lbl = QLabel(f"⏱ {mins}m {secs:02d}s")
        time_lbl.setObjectName("resultTime")

        transfer_text = (
            "No transfer" if n_transfers == 0
            else f"{n_transfers} transfer{'s' if n_transfers > 1 else ''}"
        )
        stops_lbl = QLabel(
            f"{len(path) - 1} stop{'s' if len(path) - 1 != 1 else ''}  ·  {transfer_text}"
        )
        stops_lbl.setObjectName("resultSub")

        v = QVBoxLayout()
        v.setSpacing(2)
        v.addWidget(time_lbl)
        v.addWidget(stops_lbl)
        h_layout.addLayout(v)
        h_layout.addStretch()

        self.result_layout.addWidget(header)
        self.result_layout.addSpacing(10)

        # STEPS
        steps_card = QFrame()
        steps_card.setObjectName("card")
        steps_layout = QVBoxLayout(steps_card)
        steps_layout.setContentsMargins(14, 10, 14, 10)
        steps_layout.setSpacing(0)

        for i, (station, line) in enumerate(path):
            is_first = i == 0
            is_last = i == len(path) - 1
            is_transfer = station in transfers

            row = QHBoxLayout()
            row.setContentsMargins(0, 6, 0, 6)
            row.setSpacing(10)

            # Icon column
            if is_first:
                icon = "🟢"
            elif is_last:
                icon = "🏁"
            elif is_transfer:
                icon = "🔄"
            else:
                icon = "·"

            icon_lbl = QLabel(icon)
            icon_lbl.setFixedWidth(22)
            icon_lbl.setAlignment(Qt.AlignCenter)
            icon_lbl.setFont(QFont("Arial", 13))
            row.addWidget(icon_lbl)

            # Station + line
            text_col = QVBoxLayout()
            text_col.setSpacing(0)
            station_lbl = QLabel(station)
            station_lbl.setObjectName("stepStation")
            if is_first or is_last:
                station_lbl.setStyleSheet("font-weight: 700;")
            text_col.addWidget(station_lbl)

            line_lbl = QLabel(f"Line {line}")
            line_lbl.setObjectName("stepLine")
            text_col.addWidget(line_lbl)
            row.addLayout(text_col, 1)

            # Transfer badge
            if is_transfer:
                badge = QLabel("Transfer")
                badge.setObjectName("transferBadge")
                row.addWidget(badge)

            steps_layout.addLayout(row)

            # divider (not after last)
            if not is_last:
                div = QFrame()
                div.setFrameShape(QFrame.HLine)
                div.setStyleSheet(f"color: {BORDER}; margin-left: 32px;")
                steps_layout.addWidget(div)

        self.result_layout.addWidget(steps_card)
        self.result_layout.addStretch()


# ENTRY POINT

def main():
    app = QApplication(sys.argv)
    app.setApplicationName("Transport Route Planner")

    # Use system fonts nicely
    font = QFont("SF Pro Display", 13)
    font.setStyleHint(QFont.SansSerif)
    app.setFont(font)

    win = TransportApp()
    win.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
